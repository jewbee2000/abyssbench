{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abyssbench:event:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "clock", "sequence", "time_ms", "kind", "data"],
  "properties": {
    "schema_version": {"const": 1}, "clock": {"const": "simulation"},
    "sequence": {"type": "integer", "minimum": 0},
    "time_ms": {"type": "integer", "minimum": 0},
    "kind": {"enum": ["measurement", "command", "state", "tick", "fault", "request", "command_result", "connection", "heartbeat", "actuator", "injection", "numerical"]},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "measurement"}}}, "then": {"properties": {"data": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "value", "unit", "sample_time_ms", "receive_time_ms", "quality", "sequence", "calibration_id"],
      "properties": {
        "channel": {"type": "string", "minLength": 1}, "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}, "sample_time_ms": {"type": ["integer", "null"]},
        "receive_time_ms": {"type": "integer", "minimum": 0}, "quality": {"enum": ["good", "bad", "uncertain"]},
        "sequence": {"type": "integer", "minimum": 0}, "calibration_id": {"type": "string", "minLength": 1}
      }
    }}}},
    {"if": {"properties": {"kind": {"const": "state"}}}, "then": {"properties": {"data": {
      "required": ["state", "history"], "properties": {"state": {"type": "string"}, "history": {"type": "array", "items": {"type": "string"}}}
    }}}},
    {"if": {"properties": {"kind": {"const": "fault"}}}, "then": {"properties": {"data": {"required": ["cause"], "properties": {"cause": {"type": "string"}}}}}},
    {"if": {"properties": {"kind": {"const": "connection"}}}, "then": {"properties": {"data": {"required": ["connected"], "properties": {"connected": {"type": "boolean"}}}}}},
    {"if": {"properties": {"kind": {"const": "heartbeat"}}}, "then": {"properties": {"data": {"required": ["received_at_ms"], "properties": {"received_at_ms": {"type": "integer"}}}}}},
    {"if": {"properties": {"kind": {"const": "actuator"}}}, "then": {"properties": {"data": {"required": ["valve"], "properties": {"valve": {"type": "number", "minimum": 0, "maximum": 1}}}}}}
  ]
}
